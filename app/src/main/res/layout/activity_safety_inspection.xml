<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/safety_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light">

    <!-- Header Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/red"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Back"
            android:src="@drawable/ic_customer_technician_back_white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:text="Mandatory Safety Inspection"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_sos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚨 SOS"
            android:textColor="@color/white"
            android:backgroundTint="#CC0000"
            android:textSize="12sp"
            android:paddingHorizontal="8dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Section A: Roadside & Area Safety Assessment -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A. Roadside &amp; Environmental Area Safety"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/red"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Assess passing traffic, ground stability, warning triangles placement, and fire/fluid leakage hazards."
                android:textColor="@color/text_secondary_light"
                android:textSize="13sp"
                android:layout_marginBottom="8dp"/>

            <RadioGroup
                android:id="@+id/rg_area_safe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <RadioButton
                    android:id="@+id/rb_area_safe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Safe Area"
                    android:checked="true"
                    android:textColor="@color/text_primary_light"/>

                <RadioButton
                    android:id="@+id/rb_area_unsafe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️ UNSAFE ENVIRONMENT"
                    android:textColor="@color/red"
                    android:layout_marginStart="16dp"/>
            </RadioGroup>

            <EditText
                android:id="@+id/et_area_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Area hazard details / explanatory notes (Required if unsafe)..."
                android:inputType="textMultiLine"
                android:layout_marginBottom="16dp"/>

            <!-- Section B: Personal Safety Equipment (PPE) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="B. Personal Safety &amp; PPE"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/red"
                android:layout_marginBottom="8dp"/>

            <CheckBox
                android:id="@+id/cb_ppe_vest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reflective vest and safety boots worn"
                android:checked="true"/>

            <CheckBox
                android:id="@+id/cb_ppe_gloves"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Protective gloves and eye protection available"
                android:checked="true"
                android:layout_marginBottom="16dp"/>

            <!-- Section C: Vehicle Safety & Isolation -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="C. Vehicle Stability &amp; Isolation"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/red"
                android:layout_marginBottom="8dp"/>

            <CheckBox
                android:id="@+id/cb_chocks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Parking brake set &amp; wheel chocks positioned"
                android:checked="true"/>

            <CheckBox
                android:id="@+id/cb_isolation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Engine isolated &amp; air pressure hazards checked"
                android:checked="true"
                android:layout_marginBottom="24dp"/>

            <Button
                android:id="@+id/btn_submit_safety"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Submit Safety Inspection"
                android:textColor="@color/white"
                android:backgroundTint="@color/red"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
