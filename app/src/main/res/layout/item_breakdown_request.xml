<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:id="@+id/active_breakdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Status & Urgency Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tv_job_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status: Assigned"
                android:textColor="@color/white"
                android:background="@color/red"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tv_urgency_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Urgency: Medium"
                android:textColor="@color/text_secondary_light"
                android:textSize="12sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_breakdown_photo"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:background="#DDDDDD"
                android:contentDescription="Breakdown Photo"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_truck_reg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/red"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="CA 123-456" />

                <TextView
                    android:id="@+id/tv_timestamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    tools:text="Logged: 2023-10-27 15:45" />

                <TextView
                    android:id="@+id/tv_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/black"
                    tools:text="Air leak on trailer brakes near rear axle." />
            </LinearLayout>
        </LinearLayout>

        <!-- Accept / Reject Assignment Row (Shown when assigned but not accepted yet) -->
        <LinearLayout
            android:id="@+id/row_accept_reject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:visibility="visible">

            <Button
                android:id="@+id/btn_accept_job"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Accept Job"
                android:textColor="@color/white"
                android:backgroundTint="@color/red"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btn_reject_job"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Reject Job"
                android:textColor="@color/red"
                android:layout_marginStart="4dp"/>
        </LinearLayout>

        <!-- Workflow Action Buttons -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_view_location"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🗺️ Map Nav"
                    android:textColor="@color/red"
                    android:layout_marginEnd="4dp"/>

                <Button
                    android:id="@+id/btn_safety"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛡️ Safety Inspection"
                    android:textColor="@color/red"
                    android:layout_marginEnd="4dp"/>

                <Button
                    android:id="@+id/btn_assessment"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📋 Assessment &amp; Quote"
                    android:textColor="@color/red"
                    android:layout_marginEnd="4dp"/>

                <Button
                    android:id="@+id/btn_progress"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔄 Progress Log"
                    android:textColor="@color/red"
                    android:layout_marginEnd="4dp"/>

                <Button
                    android:id="@+id/btn_parts"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚙️ Parts &amp; Approval"
                    android:textColor="@color/red"
                    android:layout_marginEnd="4dp"/>

                <Button
                    android:id="@+id/btn_messages"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💬 Chat"
                    android:textColor="@color/red"
                    android:layout_marginEnd="4dp"/>

                <Button
                    android:id="@+id/btn_return_job"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚩 Flag Return"
                    android:textColor="@color/red"
                    android:layout_marginEnd="4dp"/>

                <Button
                    android:id="@+id/btn_open_job_card"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📝 Final Job Card"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/red"/>
            </LinearLayout>
        </HorizontalScrollView>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
