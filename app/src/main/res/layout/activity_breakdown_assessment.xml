<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/assessment_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light">

    <!-- Header Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/red"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Back"
            android:src="@drawable/ic_customer_technician_back_white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:text="Breakdown Assessment &amp; Quote"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_sos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚨 SOS"
            android:textColor="@color/white"
            android:backgroundTint="#CC0000"
            android:textSize="12sp"
            android:paddingHorizontal="8dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Quotation Status Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/surface_light"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_quote_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Quotation Status: Draft"
                        android:textColor="@color/red"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tv_admin_notes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Admin Approval Notes: Pending submission"
                        android:textColor="@color/text_secondary_light"
                        android:textSize="13sp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 1. Truck Information -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Truck Profile &amp; Odometer"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/red"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/et_truck_make_model"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Truck Make &amp; Model (e.g. Volvo FH 440)"
                android:inputType="text"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/et_vin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="VIN / Chassis Number"
                android:inputType="text"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/et_odometer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Truck Odometer (KM)"
                android:inputType="numberDecimal"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/et_engine_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Engine Info / Specs"
                android:inputType="text"
                android:layout_marginBottom="16dp"/>

            <!-- 2. Breakdown Diagnosis & Observations -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. Breakdown Diagnosis"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/red"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/et_complaint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Customer's Original Complaint"
                android:inputType="textMultiLine"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/et_observations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Technician Observations"
                android:inputType="textMultiLine"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/et_fault_identified"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Identified Fault"
                android:inputType="text"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/et_cause"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Possible Cause"
                android:inputType="text"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/et_diagnostic_results"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Diagnostic Results (OBD Fault Codes, Pressure Test)"
                android:inputType="textMultiLine"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/et_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Breakdown Category (Air Brake, Electrical, Engine...)"
                android:inputType="text"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/et_recommendations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Repair Recommendation"
                android:inputType="textMultiLine"
                android:layout_marginBottom="16dp"/>

            <!-- 3. Labour, Parts & Expenses Estimates -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3. Labour, Parts &amp; Callout Expenses"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/red"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <EditText
                    android:id="@+id/et_est_techs"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Est. Technicians"
                    android:inputType="number"
                    android:layout_marginEnd="4dp"/>

                <EditText
                    android:id="@+id/et_est_hours"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Est. Hours"
                    android:inputType="numberDecimal"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>

            <EditText
                android:id="@+id/et_labour_rate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Labour Rate per Hour (R)"
                android:inputType="numberDecimal"
                android:text="450.00"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/et_est_parts_cost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Estimated Parts Cost Total (R)"
                android:inputType="numberDecimal"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <EditText
                    android:id="@+id/et_callout_fee"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Callout Fee (R)"
                    android:inputType="numberDecimal"
                    android:text="500.00"
                    android:layout_marginEnd="4dp"/>

                <EditText
                    android:id="@+id/et_travel_expense"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Travel Charge (R)"
                    android:inputType="numberDecimal"
                    android:text="250.00"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>

            <!-- 4. Total Calculation & Submit -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/red"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tv_calculated_total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TOTAL ESTIMATED COST: R 1,200.00"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Button
                android:id="@+id/btn_calc_total"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Calculate Total Quote"
                android:textColor="@color/red"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btn_submit_quotation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Submit Assessment &amp; Quotation"
                android:textColor="@color/white"
                android:backgroundTint="@color/red"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
