<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parts_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light">

    <!-- Header Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/red"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Back"
            android:src="@drawable/ic_customer_technician_back_white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:text="Parts &amp; Additional Work Approval"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_sos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚨 SOS"
            android:textColor="@color/white"
            android:backgroundTint="#CC0000"
            android:textSize="12sp"
            android:paddingHorizontal="8dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. Record Spare Parts Used -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Record Spare Parts Used On Job"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/red"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/et_part_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Part Name / Description (e.g. WABCO Relay Valve)"
                android:inputType="text"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <EditText
                    android:id="@+id/et_part_no"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Part Number (OEM)"
                    android:inputType="text"
                    android:layout_marginEnd="4dp"/>

                <EditText
                    android:id="@+id/et_qty"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Quantity"
                    android:inputType="number"
                    android:text="1"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>

            <Button
                android:id="@+id/btn_add_part"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Add Part To Job Card"
                android:textColor="@color/red"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tv_parts_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Parts Added: None"
                android:textColor="@color/text_primary_light"
                android:textSize="14sp"
                android:padding="8dp"
                android:background="@color/surface_light"
                android:layout_marginBottom="24dp"/>

            <!-- 2. Additional Work Approval Request -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. Request Approval For Additional Work / Costs"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/red"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Technicians MUST NOT perform additional chargeable work outside approved quotation without Administrator authorization."
                android:textColor="@color/text_secondary_light"
                android:textSize="13sp"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/et_add_work_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Describe additional damage or extra work required..."
                android:inputType="textMultiLine"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/et_add_cost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Additional Estimated Cost (R)"
                android:inputType="numberDecimal"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/btn_request_add_work"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Submit Additional Work Request"
                android:textColor="@color/white"
                android:backgroundTint="@color/red"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
