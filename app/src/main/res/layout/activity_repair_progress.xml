<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/progress_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light">

    <!-- Header Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/red"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Back"
            android:src="@drawable/ic_customer_technician_back_white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:text="Repair Progress &amp; Status"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_sos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚨 SOS"
            android:textColor="@color/white"
            android:backgroundTint="#CC0000"
            android:textSize="12sp"
            android:paddingHorizontal="8dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Current Status Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/surface_light"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_current_job_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Current Status: Repair in Progress"
                        android:textColor="@color/red"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tv_current_eta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Estimated Completion ETA: 45 Mins"
                        android:textColor="@color/text_secondary_light"
                        android:textSize="13sp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Quick Milestone Selection -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Progress Milestone / Milestone Update:"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary_light"
                android:layout_marginBottom="8dp"/>

            <Spinner
                android:id="@+id/spinner_milestones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:drawable/btn_dropdown"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/et_progress_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Provide details of work completed or delay reason..."
                android:inputType="textMultiLine"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/et_update_eta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Update ETA (e.g. 15:30 or 1 hr remaining)"
                android:inputType="text"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/btn_send_update"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Publish Progress Update"
                android:textColor="@color/white"
                android:backgroundTint="@color/red"
                android:layout_marginBottom="16dp"/>

            <!-- Progress Log Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Activity &amp; Progress Log:"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/red"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:id="@+id/container_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
