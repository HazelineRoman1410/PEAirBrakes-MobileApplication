<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/manual_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light"
    tools:context=".UserManualActivity">

    <!-- Header Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/red"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_customer_technician_back_white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:text="@string/user_manual_title"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Search & Filter Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:background="@color/surface_light"
        android:orientation="vertical">

        <!-- Search Manual -->
        <EditText
            android:id="@+id/et_manual_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/manual_search_hint"
            android:background="@android:drawable/editbox_background"
            android:padding="10dp"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"
            android:singleLine="true"
            android:inputType="text" />

        <!-- Category Filters -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- All Categories -->
                <Button
                    android:id="@+id/btn_filter_all"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/category_all"
                    android:textColor="@color/red"
                    android:layout_marginEnd="6dp" />

                <!-- Technician Category -->
                <Button
                    android:id="@+id/btn_filter_tech"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/category_technician"
                    android:textColor="@color/red"
                    android:layout_marginEnd="6dp" />

                <!-- Customer Category -->
                <Button
                    android:id="@+id/btn_filter_customer"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/category_customer"
                    android:textColor="@color/red"
                    android:layout_marginEnd="6dp" />

                <!-- FAQs Category -->
                <Button
                    android:id="@+id/btn_filter_faq"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/category_faqs"
                    android:textColor="@color/red" />

            </LinearLayout>
        </HorizontalScrollView>

    </LinearLayout>

    <!-- Manual Sections -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/container_manual_sections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Contact Support -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:background="@color/surface_light"
        android:gravity="center"
        android:orientation="horizontal">

    </LinearLayout>

</LinearLayout>
