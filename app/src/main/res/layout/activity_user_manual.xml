<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/manual_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light">

    <!-- Header Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/red"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Back"
            android:src="@drawable/ic_customer_technician_back_white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:text="User Manual &amp; App Help"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_sos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚨 SOS"
            android:textColor="@color/white"
            android:backgroundTint="#CC0000"
            android:textSize="12sp"
            android:paddingHorizontal="8dp"/>
    </LinearLayout>

    <!-- Search & Filter Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:background="@color/surface_light"
        android:orientation="vertical">

        <EditText
            android:id="@+id/et_manual_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Search user manual (e.g. quote, safety, map, ETA)..."
            android:background="@android:drawable/editbox_background"
            android:padding="10dp"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_filter_all"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All Topics"
                    android:textColor="@color/red"
                    android:layout_marginEnd="6dp"/>

                <Button
                    android:id="@+id/btn_filter_tech"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛠️ Technician"
                    android:textColor="@color/red"
                    android:layout_marginEnd="6dp"/>

                <Button
                    android:id="@+id/btn_filter_customer"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚚 Customer"
                    android:textColor="@color/red"
                    android:layout_marginEnd="6dp"/>

                <Button
                    android:id="@+id/btn_filter_admin"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏢 Administrator"
                    android:textColor="@color/red"
                    android:layout_marginEnd="6dp"/>

                <Button
                    android:id="@+id/btn_filter_faq"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="❓ FAQs"
                    android:textColor="@color/red"/>
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/container_manual_sections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Contact Support -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:background="@color/surface_light"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_contact_support"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📞 Need Further Help? Contact Dispatch Support"
            android:textColor="@color/white"
            android:backgroundTint="@color/red"/>
    </LinearLayout>
</LinearLayout>
