<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".TechnicianSettingActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/technician_settings_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="73dp"
            android:layout_height="45dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_customer_technician_back" />

        <TextView
            android:id="@+id/tv_setting_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/technician_settings"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/red"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_back"
            android:layout_marginTop="24dp" />

        <TextView
            android:id="@+id/tv_label_language"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/technician_languages"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/tv_setting_title"
            app:layout_constraintStart_toStartOf="parent" />

        <Button
            android:id="@+id/btn_english"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/technician_english"
            android:backgroundTint="@color/red"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/tv_label_language"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btn_afrikaans"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/technician_afrikaans"
            android:backgroundTint="@color/red"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/btn_english"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btn_xhosa"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/technician_xhosa"
            android:backgroundTint="@color/red"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/btn_afrikaans"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btn_tswana"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/technician_tswana"
            android:backgroundTint="@color/red"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/btn_xhosa"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="24dp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/tv_theme_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/technician_dark_mode"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/btn_tswana"
            app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>