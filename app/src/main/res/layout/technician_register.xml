<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".RegisterTechnicianActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/register_technician_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/register_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/technician_reg_title"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/red"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="24dp" />

        <EditText
            android:id="@+id/et_reg_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/full_name_hint"
            android:inputType="textPersonName"
            android:autofillHints="name"
            app:layout_constraintTop_toBottomOf="@id/register_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="24dp" />

        <EditText
            android:id="@+id/et_reg_email"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/email_hint"
            android:inputType="textEmailAddress"
            android:autofillHints="emailAddress"
            app:layout_constraintTop_toBottomOf="@id/et_reg_name"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/et_tech_specialty"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/tech_specialty"
            android:inputType="text"
            app:layout_constraintTop_toBottomOf="@id/et_reg_email"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/et_reg_password"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/password_hint"
            android:inputType="textPassword"
            android:autofillHints="password"
            app:layout_constraintTop_toBottomOf="@id/et_tech_specialty"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tv_verification_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/verification_required"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/et_reg_password"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="24dp" />

        <Button
            android:id="@+id/btn_scan_qr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/scan_qr"
            android:backgroundTint="@color/black"
            app:layout_constraintTop_toBottomOf="@id/tv_verification_label"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tv_verification_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_not_verified"
            android:textColor="@color/red"
            app:layout_constraintTop_toBottomOf="@id/btn_scan_qr"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btn_register"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/register_title"
            android:backgroundTint="@color/red"
            android:enabled="true"
            app:layout_constraintTop_toBottomOf="@id/tv_verification_status"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="32dp" />

        <TextView
            android:id="@+id/tv_go_to_login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/already_have_account"
            android:textColor="@color/black"
            app:layout_constraintTop_toBottomOf="@id/btn_register"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>